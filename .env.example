# Copy to .env (git-ignored). All optional.
PORT=8787
# Enables the official-API provider (geo-filtered live search). Without it, scraping + seed are used.
YOUTUBE_API_KEY=
# Optional: official Google Fact Check Tools API (adds claim search to the truth sensor).
GOOGLE_FACTCHECK_API_KEY=
# Live ships at chokepoints (free key: https://aisstream.io)
AISSTREAM_API_KEY=
# Optional: Claude for analyst briefs + semantic claim matching.
ANTHROPIC_API_KEY=
PANOPTES_LLM_MODEL=claude-haiku-4-5
PANOPTES_LLM_MAX_PER_HOUR=60
# Entity graph: Claude reads at most this many events per hour to refine places, actors and claims.
PANOPTES_EXTRACT_PER_HOUR=25
# SQLite file for cases, watches and the Apify ledger (point it at a persistent disk in production).
# PANOPTES_DB=data/panoptes.db
# Optional extra sources.
ACLED_EMAIL=
ACLED_PASSWORD=
FIRMS_MAP_KEY=
CLOUDFLARE_RADAR_TOKEN=
# Optional: override where Google Trends data is read from (default: the repo's data branch, filled by .github/workflows/trends-relay.yml)
TRENDS_RELAY_URL=

# Twitter/X layer: Grok (xAI) reads public X posts to give a second opinion on unverified stories.
# Optional; checks run only while the Twitter/X switch is on, capped per hour.
XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast
# XAI_MAX_PER_HOUR=20

# Optional: your own Cesium ion token for 3D terrain (free at https://ion.cesium.com). Read at BUILD time
# (Vite), so on Render set it in the dashboard before the build. Without it Cesium's evaluation token is used
# and the globe shows a notice.
VITE_CESIUM_ION_TOKEN=

# Optional: Apify token for on-demand X / TikTok / Instagram searches (transforms marked 💲). Every run is capped
# (15 results; per-run charge ceiling $0.10, or the actor's own minimum) and a ledger stops all runs
# past APIFY_BUDGET_USD (default 2.5).
APIFY_TOKEN=
APIFY_BUDGET_USD=2.5

# Photo geolocation (sleuth/): the tool server's address and its bearer token (any long random string,
# the same value on both sides). Locally the server runs without a token when SLEUTH_DEV=1.
SLEUTH_URL=http://127.0.0.1:8790
SLEUTH_TOKEN=
# Per-run and daily spend limits (USD) and tool calls per run
SLEUTH_USD_HAIKU=0.15
SLEUTH_DAILY_USD=5
SLEUTH_MAX_STEPS=40
