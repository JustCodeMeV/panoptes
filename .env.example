# Copy to .env (git-ignored). All optional.
PORT=8787
# Enables the official-API provider (geo-filtered live search). Without it, scraping + seed are used.
YOUTUBE_API_KEY=
# Optional: official Google Fact Check Tools API (adds claim search to the truth sensor).
GOOGLE_FACTCHECK_API_KEY=
# Live ships at chokepoints (free key: https://aisstream.io)
AISSTREAM_API_KEY=
# Optional: Claude for analyst briefs + semantic claim matching.
ANTHROPIC_API_KEY=
PANOPTES_LLM_MODEL=claude-haiku-4-5
PANOPTES_LLM_MAX_PER_HOUR=60
# Optional extra sources.
ACLED_EMAIL=
ACLED_PASSWORD=
FIRMS_MAP_KEY=
CLOUDFLARE_RADAR_TOKEN=
# Optional: override where Google Trends data is read from (default: the repo's data branch, filled by .github/workflows/trends-relay.yml)
TRENDS_RELAY_URL=

# Twitter/X layer: Grok (xAI) reads public X posts to give a second opinion on unverified stories.
# Optional; checks run only while the Twitter/X switch is on, capped per hour.
XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast
# XAI_MAX_PER_HOUR=20
