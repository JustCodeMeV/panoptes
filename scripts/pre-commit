#!/bin/sh
# Blocks commits that add something shaped like a credential, or any .env file.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "pre-commit: refusing to commit a .env file" >&2
  exit 1
fi
pattern='sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{30,}|ghp_[0-9A-Za-z]{30,}|xox[bpa]-[0-9A-Za-z-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(PASSWORD|TOKEN|SECRET|API_KEY)=[^[:space:]]{6,}'
if git diff --cached -U0 -- . ':(exclude).env.example' | grep '^+' | grep -E "$pattern" >/dev/null; then
  echo "pre-commit: staged changes look like they contain a secret:" >&2
  git diff --cached -U0 -- . ':(exclude).env.example' | grep '^+' | grep -nE "$pattern" | sed -E 's/(=|-)[A-Za-z0-9_-]{6,}/\1[hidden]/g' >&2
  echo "Move it to .env (local) or the Render dashboard (production)." >&2
  exit 1
fi
